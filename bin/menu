#!/usr/bin/env bash

set -e  # Exit on error
set -u  # Undefined variable check

MERGED_PATH="$HOME/.local/bin/menu_items/merged.json"
SEPARATOR=$'\t'


# Update merged json file
if [ ! -f "$MERGED_PATH" ]; then
    echo "File '$MERGED_PATH' does not exists, a creation attempt will be done..."
fi
pushd $(dirname $MERGED_PATH) > /dev/null
make -s
popd > /dev/null


# Filter attributes and output a formatted string representation of each json object
selected_row=$(
    jq 'to_entries | map({id:.value.id, description:.value.description, cmd:.value.command})' "$MERGED_PATH" |
    jq -r '(.[] | [.id, .description, .cmd]) | @tsv' |
    column -t --separator $'\t' --output-separator "$SEPARATOR" --table-right 1 |
    fzf
)

# Map each column from the selected row. Also remove any leading and trailing spaces
id=$(cut -d"$SEPARATOR" -f1 <<< "$selected_row" | xargs)
description=$(cut -d"$SEPARATOR" -f2 <<< "$selected_row" | xargs)
cmd=$(cut -d"$SEPARATOR" -f3 <<< "$selected_row" | xargs)

echo $cmd
echo ""
echo -n $cmd | cb
echo "Command copied in system clipboard"

# Use id to extract individual attributes from the whole json object
object=$(jq --arg id "$id" '.[] | select(.id == ($id | tonumber))' "$MERGED_PATH")
name=$(echo "$object" | jq -r '.name')

# Retrieve the hints array and parse it as a bash array
if echo "$object" | jq -e '.hints' > /dev/null; then
    echo ""
    echo "Hints:"
    hints=$(echo "$object" | jq -r '.hints | @sh')
    declare -a hints_array="($hints)"

    # Pretty print with numbers
    counter=1
    for hint in "${hints_array[@]}"; do
        echo "$counter) $hint"
        ((counter++))
    done
else
    echo "Command had no hint to show."
fi


# TODO: Interactive execution
# echo -n "Press 'Enter' to execute it or CTRL+C to cancel..."
# read
# eval $selected_cmd 


